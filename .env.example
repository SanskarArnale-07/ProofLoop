# ==========================================
# PROOFLOOP CONFIGURATION & ENVIRONMENT
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or share real secrets (it is git-ignored).
# ==========================================

# Port (optional, defaults to 3000)
PORT=3000

# ==========================================
# POSTGRESQL / NEON DATABASE CONFIGURATION
# ==========================================
# DATABASE_URL: Pooled connection string used for regular application runtime queries.
# Use Neon's pooled endpoint (-pooler) for serverless scalability on Vercel.
DATABASE_URL=postgresql://user:password@ep-cool-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# DATABASE_URL_UNPOOLED: Direct/unpooled connection string used for migrations and data import scripts.
# Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# GitHub API access
# Public repository scanning works without a token (60 requests/hr).
# A personal access token raises this to 5,000 requests/hr and allows private repos.
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub webhook secret (REQUIRED for the webhook to accept anything)
# Generate one:  openssl rand -hex 32
# Use the SAME value in GitHub: repo Settings > Webhooks > Secret.
# Payload URL: https://<your-public-host>/api/webhooks/github
# Content type: application/json   |   Events: "Just the push event"
# See WEBHOOK_SETUP.md for step-by-step instructions.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Local development only: accept unsigned webhooks when no secret is set.
# Ignored when NODE_ENV=production. Leave unset unless you know you need it.
# PROOFLOOP_ALLOW_UNSIGNED_WEBHOOKS=true

# Note: ProofLoop makes no LLM/AI calls. Evidence extraction and ranking are
# deterministic, so no OpenAI/Gemini keys are needed.
