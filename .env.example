# ==========================================
# PROOFLOOP CONFIGURATION & ENVIRONMENT
# ==========================================

# Port (optional, defaults to 3000)
PORT=3000

# GitHub Integration
# Public repository scanning works without a token (up to 60 requests/hr).
# Add a personal access token for higher rate limits (5,000 req/hr) and private repo access:
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Webhooks Secret
# Shared secret configured in your repository webhook settings:
# Payload URL: https://your-domain.com/api/webhooks/github
# Content type: application/json
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Optional LLM API Provider (for enhanced semantic interpretations)
# The application includes deterministic static evidence extraction and works 100% out of the box without keys.
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
